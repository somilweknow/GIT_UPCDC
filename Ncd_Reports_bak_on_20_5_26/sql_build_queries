CREATE TABLE ncd_cooperatives_validation (

    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,

    ncd_cooperative_id INT NOT NULL,

    request_id INT NOT NULL DEFAULT 1,  -- version / attempt number

    -- =========================
    -- STATUS FLAGS
    -- =========================
    maker_status TINYINT NOT NULL DEFAULT 0 COMMENT '0=not submitted,1=submitted',

    checker_status TINYINT NOT NULL DEFAULT 0 COMMENT '0=pending,1=approved,2=rejected',

    admin_status TINYINT NOT NULL DEFAULT 0 COMMENT '0=pending,1=approved,2=rejected',

    -- =========================
    -- REMARKS
    -- =========================
    checker_remark TEXT NULL,
    admin_remark TEXT NULL,

    -- =========================
    -- WORKFLOW TRACKING
    -- =========================
    current_stage ENUM('maker','checker','admin','completed')
        NOT NULL DEFAULT 'maker',

    final_status ENUM('in_progress','approved','rejected')
        NOT NULL DEFAULT 'in_progress',

    -- =========================
    -- TIMESTAMPS
    -- =========================
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,

    -- =========================
    -- INDEXES
    -- =========================
    INDEX idx_cooperative (ncd_cooperative_id),
    INDEX idx_request (ncd_cooperative_id, request_id),
    INDEX idx_stage (current_stage),
    INDEX idx_final_status (final_status)

);

ALTER TABLE ncd_cooperatives_validation
