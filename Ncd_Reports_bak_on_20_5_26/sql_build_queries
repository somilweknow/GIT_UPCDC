CREATE TABLE ncd_users (
    id INT AUTO_INCREMENT PRIMARY KEY,

    type_id INT NOT NULL,   -- FK to ncd_user_type

    name VARCHAR(100) NOT NULL UNIQUE,
    u_name VARCHAR(100) NOT NULL UNIQUE,
    u_pass VARCHAR(255) NOT NULL,

    division_id INT NULL,
    division_name VARCHAR(150) NULL,

    district_id INT NULL,
    district_name VARCHAR(150) NULL,

    is_active TINYINT(1) DEFAULT 1,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (type_id) REFERENCES ncd_user_type(id)
);

